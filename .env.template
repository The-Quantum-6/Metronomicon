POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db
DATABASE_URL=postgresql://postgres:postgres@db:5432/db

# Enables the permissive CORS layer so the Vite dev server can call the backend
# cross-origin. Set to anything other than "dev" in production.
ENVIRONMENT=dev

FEIDE_SECRET=secret
FEIDE_CLIENT_ID=client_id
# Base URL the frontend uses for API calls. With the bundled proxy, "/api"
# routes to the backend. Override to point at another backend.
API_BASE_URL=/api

# --- Garage / S3 object storage ---
# The backend container reaches Garage by its compose service name.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=test-bucket
# Max accepted upload size in bytes for /files multipart requests.
UPLOAD_MAX_BYTES=10485760
# Generate a unique local-dev keypair and keep it in your untracked `.env`.
# Do not reuse local credentials in production. Key ID must start with "GK";
# generate one with:
#   echo "GK$(openssl rand -hex 16)" && openssl rand -hex 32
AWS_ACCESS_KEY_ID=GK__GENERATE_ME__
AWS_SECRET_ACCESS_KEY=__GENERATE_ME__
