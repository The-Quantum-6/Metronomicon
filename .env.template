POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db
DATABASE_URL=postgresql://postgres:postgres@db:5432/db

# Enables the permissive CORS layer so the Vite dev server can call the backend
# cross-origin. Set to anything other than "dev" in production.
ENVIRONMENT=dev

FEIDE_SECRET=secret
FEIDE_CLIENT_ID=client_id
# Base URL the frontend uses for API calls. With the bundled proxy, "/api"
# routes to the backend. Override to point at another backend.
API_BASE_URL=/api

# --- Garage / S3 object storage ---
# The backend container reaches Garage by its compose service name.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=test-bucket
# Garage creates this key automatically on first start (via GARAGE_DEFAULT_*
# in compose.yaml), so the same values work out of the box. These are
# LOCAL-DEV-ONLY credentials for a localhost-only service — like rpc_secret
# in garage.toml, they are fine to commit but must never be reused in
# production. Key ID must start with "GK"; regenerate with:
#   echo "GK$(openssl rand -hex 16)" && openssl rand -hex 32
AWS_ACCESS_KEY_ID=GK78adb9bda5c63659600fb31e8d3ef4f3
AWS_SECRET_ACCESS_KEY=2584b0fcbfa0c3d4092a0b8363df6b96ae5463d6b1af88563c1fa2eefae67079
