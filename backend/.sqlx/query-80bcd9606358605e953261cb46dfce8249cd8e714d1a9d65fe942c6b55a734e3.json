  "query": "\n            SELECT aggregate_id, course_id, contribution, status\n            FROM contribution_list_view\n            WHERE ($1::text IS NULL OR course_id = $1)\n            ORDER BY \n                CASE WHEN status = 'Proposed' THEN 0 ELSE 1 END,\n                aggregate_id\n            ",
